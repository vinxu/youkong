# Server
SERVER_PORT=8080
SERVER_MODE=debug

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=youkong

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE_HOURS=168

# Tencent Cloud
TENCENT_SECRET_ID=your_secret_id
TENCENT_SECRET_KEY=your_secret_key
TENCENT_SMS_SDK_APP_ID=your_sms_app_id
TENCENT_SMS_SIGN_NAME=有空
TENCENT_SMS_TEMPLATE_ID=your_template_id

# COS
TENCENT_COS_BUCKET=your_bucket_name
TENCENT_COS_REGION=ap-beijing

# WeChat
WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_app_secret

# Invitation
INVITATION_BASE_URL=https://youkong.app/i/
INVITATION_DEFAULT_EXPIRE_DAYS=7
INVITATION_DEFAULT_MAX_USES=100
INVITATION_RATE_LIMIT_PER_DAY=10

# LLM (OpenRouter)
LLM_PROVIDER=openrouter
LLM_API_KEY=your_openrouter_api_key
LLM_MODEL=google/gemini-2.5-pro-preview-06-05
